# Project settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Terminal app runs as an admin tool, so it uses the service role key.
# Never ship this key to a browser or commit it.
SUPABASE_KEY=your-service-role-key

# Storage bucket that holds the objects
VAULTLINE_BUCKET=vaultline-files

# Tables
VAULTLINE_FILES_TABLE=file_records
VAULTLINE_NOTES_TABLE=notes

# Edge Function slug deployed with the Supabase CLI
VAULTLINE_EDGE_FUNCTION=validate-upload

# Upload rules enforced inside the Edge Function
VAULTLINE_MAX_MB=10
